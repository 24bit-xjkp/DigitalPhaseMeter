target
# project/ 下只入库构建定义（含 sbt 版本文件与插件声明）；Metals 等工具生成的其余文件继续忽略
project/*
!project/*.scala
!project/build.properties
!project/plugins.sbt
build
.vscode
.metals
.bloop
.bsp
.xmake
.VSCodeCounter
# Vivado/xsim 在仓库根目录留下的临时文件
.Xil
*.pb
xsim.dir
*.jou
*.log
*.rpt
# Python 侧（host/ 上位机与 spec/ 工具）的字节码缓存
__pycache__/
*.pyc
# uv 虚拟环境（根 .venv 由 `uv sync` 创建，不入库）
.venv/
spec/verify_*.json
spec/ps_selftest
*.semanticdb
