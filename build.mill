//| mill-version: 1.3.1
//| mill-jvm-version: system
//| mvnDeps:
//| - com.goyeau::mill-scalafix::0.6.2
package build

import mill.*
import mill.api.BuildCtx
import mill.scalalib.*

import com.goyeau.mill.scalafix.ScalafixModule
import mainargs.Flag

import java.nio.ByteBuffer
import java.nio.charset.StandardCharsets
import java.nio.file.{Files, Path}
import java.security.MessageDigest
import scala.collection.mutable
import scala.jdk.CollectionConverters.*

object `package` extends SbtModule with ScalafixModule {

    // Chisel 在编译期用 `chisel.project.root` 把源位置注释（生成的 SystemVerilog 里的
    // `// <源文件>:<行>:<列>`）相对化；编译器在 Mill 进程内执行，这里把工程根写入系统属性，
    // 使生成的 SystemVerilog 不含检出路径（不同检出/机器内容一致）。
    sys.props("chisel.project.root") = BuildCtx.workspaceRoot.toString
    private def chiselProjectRootOption = s"-Xmacro-settings:chisel.project.root=${BuildCtx.workspaceRoot}"

    def scalaVersion = "2.13.18"
    def chiselVersion = "7.16.0"

    def mvnDeps = Seq(mvn"org.chipsalliance::chisel:$chiselVersion")

    def scalacPluginMvnDeps = Seq(mvn"org.chipsalliance:::chisel-plugin:$chiselVersion")

    def scalacOptions = Seq(
        "-language:reflectiveCalls",
        "-deprecation",
        "-feature",
        "-Xcheckinit",
        "-Ymacro-annotations",
        chiselProjectRootOption,
        // Chisel 的匿名 Bundle 会「推断出结构类型」，访问其成员需要 reflective call，因此只关掉这一类。
        "-Xlint:_,-infer-structural",
        "-Wunused:imports,privates,locals,patvars,implicits,explicits",
        "-Wdead-code",
        "-Werror"
    )

    /** 生成主类运行缓存的格式版本。缓存键的构造方式变化时递增，使旧缓存条目失效。 */
    private def EmitCacheFormat = "emit-cache-v1"

    /** 生成 SystemVerilog。
      *
      * 用法：
      * {{{
      * ./mill emit                                              # 生成全部 Emit<Name>（按内容缓存，未变化的跳过）
      * ./mill emit Controller DigitalPhaseMeterTop              # 只生成指定模块
      * ./mill emit --force Controller                           # 强制重新生成
      * ./mill emit --check                                      # 查询全部入口点是否需要重新生成
      * ./mill emit --check Controller DigitalPhaseMeterTop      # 只查询指定模块
      * }}}
      *
      * 缓存语义：入口点（`Emit<Name>` 主类）及其传递依赖的字节码闭包没有变化时跳过执行； 判定看编译产物而不是源码文本，因此不改变字节码的编辑（例如在文件末尾追加注释）不会 触发重跑。缓存按主类隔离：改
      * `PhaseMeter` 只会让依赖它的入口点重跑。缓存命中后还会 确认约定产物 `build/chisel/<Name>/filelist.f` 存在，产物被删掉时会重新生成。
      *
      * `--check` 只查询：缓存判定与生成时完全一致（同一缓存键，并检查约定产物是否存在），逐模块报告是否已是最新，不生成、不写产物与缓存。全部最新时退出码为 0；有模块需要重新生成时打印汇总并以非零退出码失败（与
      * `./mill fix --check` 的检查语义一致）。`--check` 与 `--force` 互斥。
      *
      * 需要无条件重跑单个入口点时用 Mill 内置的 `runMain`： `./mill runMain DigitalPhaseMeter.EmitController`。
      */
    def emit(force: Flag = Flag(false), check: Flag = Flag(false), modules: String*) = Task.Command {
        val log = Task.ctx().log
        if check.value && force.value then Task.fail("[emit] --check 与 --force 不能同时使用：--check 只查询，不生成")

        val allEntries = emitEntries(allLocalMainClasses())
        val selected =
            if modules.isEmpty then allEntries
            else
                modules.toSeq.map { requested =>
                    allEntries
                        .find { case (name, mainClass) =>
                            name == requested ||
                            s"Emit$name" == requested ||
                            mainClass == requested ||
                            mainClass.split('.').last == requested
                        }
                        .getOrElse(Task.fail(s"[emit] 找不到模块 $requested（可用模块：${allEntries.map(_._1).mkString(", ")}）"))
                }

        val classesDir = compile().classes.path
        val classpath = runClasspath().map(_.path)
        val javaHome = jdkCommandsJavaHome().map(_.path).getOrElse(os.Path(sys.props("java.home")))
        val javaBin = javaHome / "bin" / "java"
        val forkArgsValue = forkArgs()
        val forkEnvValue = forkEnv()
        val workingDir = forkWorkingDir()
        val outputRoot = BuildCtx.workspaceRoot / "build" / "chisel"
        val cacheDir = outputRoot / ".emit-cache"

        // 项目外依赖（Chisel/firtool 等 jar）的标识：产物路径 + 文件大小。Mill 的依赖缓存按
        // 校验和校验下载物，所以路径+大小足以捕获依赖版本变化；这里不逐字节哈希几十 MB 的 jar。
        val dependencyIdentity =
            classpath
                .filter(_ != classesDir)
                .map(path => s"${path}=${if os.exists(path) then os.size(path) else -1L}")
                .sorted
                .mkString("\n")
        val runnerFingerprint = (Seq(javaBin.toString) ++ forkArgsValue).mkString("\u0000") +
            "\u0000" + forkEnvValue.toSeq.sorted.map((k, v) => s"$k=$v").mkString("\u0000")

        val classIndex = indexClasses(classesDir)
        val referenceCache = mutable.Map.empty[String, Seq[String]]
        def referencesOf(className: String): Seq[String] =
            referenceCache.getOrElseUpdate(
                className,
                classIndex.get(className).map(path => classReferences(path)).getOrElse(Seq.empty)
            )

        // 生成与 `--check` 共用同一份状态判定：缓存键与产物检查只在这里算一次，避免两套实现漂移。
        val targets = selected.map { case (name, mainClass) =>
            val cacheKey = sha256(
                Seq(
                    EmitCacheFormat,
                    // 缓存可能被多个检出共享；把工程根目录纳入键，避免不同检出互相命中。
                    BuildCtx.workspaceRoot.toString,
                    mainClass,
                    runnerFingerprint,
                    dependencyIdentity,
                    entryDigest(mainClass, classIndex, referencesOf)
                ).mkString("\n")
            )
            val stamp = cacheDir / s"$name.sha256"
            val stampValue = if os.exists(stamp) then Some(os.read(stamp).trim) else None
            EmitTarget(
                name = name,
                mainClass = mainClass,
                cacheKey = cacheKey,
                stamp = stamp,
                outputExists = os.isFile(outputRoot / name / "filelist.f"),
                stampValue = stampValue
            )
        }

        if check.value then {
            targets.foreach { target =>
                if target.needsEmit then log.info(s"[emit] ${target.name} 需要重新生成：${target.reason}")
                else log.info(s"[emit] ${target.name} 已是最新（缓存命中且产物存在）")
            }
            val stale = targets.filter(_.needsEmit)
            if stale.nonEmpty then Task.fail(s"[emit] 检查完成：${stale.size} 个模块需要重新生成：${stale.map(_.name).mkString(", ")}")
            else log.info(s"[emit] 检查完成：${targets.size} 个模块均为最新，无需重新生成")
        } else {
            var generated = 0
            var skipped = 0
            targets.foreach { target =>
                if !force.value && !target.needsEmit then {
                    log.info(s"[emit] ${target.name} 未变化，跳过（强制重跑：./mill emit --force ${target.name}）")
                    skipped += 1
                } else {
                    if force.value then log.info(s"[emit] 强制生成 ${target.name}（${target.mainClass}）")
                    else log.info(s"[emit] 生成 ${target.name}（${target.mainClass}）：${target.reason}")
                    os.makeDir.all(outputRoot / target.name)
                    runMainClass(javaBin, target.mainClass, classpath, forkArgsValue, forkEnvValue, workingDir)
                    os.makeDir.all(target.stamp / os.up)
                    os.write.over(target.stamp, target.cacheKey)
                    generated += 1
                }
            }
            log.info(s"[emit] 完成：生成 $generated 个，跳过 $skipped 个；产物目录 $outputRoot")
        }
    }

    /** 单个入口点的生成状态：生成与 `--check` 查询共用，只读、不产生副作用。
      *
      * @param outputExists
      *   约定产物 `build/chisel/<name>/filelist.f` 是否存在
      * @param stampValue
      *   缓存戳内容；缓存戳不存在时为空
      */
    private case class EmitTarget(
        name: String,
        mainClass: String,
        cacheKey: String,
        stamp: os.Path,
        outputExists: Boolean,
        stampValue: Option[String]
    ) {

        /** 与 `emit` 的缓存判定等价：产物存在且缓存戳与当前缓存键一致时不需要重新生成。 */
        def needsEmit: Boolean = !outputExists || !stampValue.contains(cacheKey)

        /** 需要重新生成的原因，用于 `emit` 与 `emit --check` 的输出。 */
        def reason: String =
            if !outputExists then s"产物缺失（build/chisel/$name/filelist.f 不存在）"
            else if stampValue.isEmpty then "没有缓存记录（首次生成或缓存被清理）"
            else "入口点或其传递依赖的字节码发生变化"
    }

    /** 发现本项目的 `Emit<Name>` 生成主类，返回 `(产物目录名, 主类全名)`。
      *
      * 产物目录名按 `Utils.scala` 的约定从主类简单名剥离 `Emit` 前缀得到（`EmitFoo` → `Foo`）； 只有 `DigitalPhaseMeter.Emit*` 参与生成，其它主类不进入该约定。
      */
    private def emitEntries(mainClasses: Seq[String]): Seq[(String, String)] =
        mainClasses
            .filter(_.startsWith("DigitalPhaseMeter.Emit"))
            .sorted
            .map { mainClass =>
                val simpleName = mainClass.split('.').last
                simpleName.stripPrefix("Emit") -> mainClass
            }

    /** 执行主类（与 Mill 的 runMain 同语义：classpath、JVM 参数、工作目录都取模块配置）。 */
    private def runMainClass(
        javaBin: os.Path,
        mainClass: String,
        classpath: Seq[os.Path],
        forkArgs: Seq[String],
        forkEnv: Map[String, String],
        workingDir: os.Path
    ): Unit = {
        val command = Seq(javaBin.toString) ++ forkArgs ++
            Seq("-cp", classpath.map(_.toString).mkString(java.io.File.pathSeparator), mainClass)
        os.proc(command)
            .call(
                cwd = workingDir,
                env = forkEnv,
                check = true,
                stdout = os.Inherit,
                stderr = os.Inherit
            )
    }

    /** 项目 class 目录里所有 class 文件：内部类名（`pkg/Foo$`） -> 文件路径。 */
    private def indexClasses(classDirectory: os.Path): Map[String, os.Path] = {
        val classDir = classDirectory.toNIO
        val result = mutable.Map.empty[String, os.Path]
        if Files.isDirectory(classDir) then {
            val stream = Files.walk(classDir)
            try
                stream.iterator.asScala
                    .filter(_.toString.endsWith(".class"))
                    .foreach { path =>
                        val name = classDir
                            .relativize(path)
                            .toString
                            .stripSuffix(".class")
                            .replace(java.io.File.separatorChar, '/')
                        result(name) = os.Path(path)
                    }
            finally stream.close()
        }
        result.toMap
    }

    /** 读一个 .class 文件的常量池，返回它引用的所有类（JVM 内部名）。
      *
      * 只做常量池的浅解析，不需要 ASM；数组类型归一化为元素类型。
      */
    private def classReferences(path: os.Path): Seq[String] = {
        val buffer = ByteBuffer.wrap(Files.readAllBytes(path.toNIO))
        if buffer.getInt() != 0xcafebabe then Seq.empty
        else {
            buffer.getShort() // minor
            buffer.getShort() // major
            val constantPoolCount = buffer.getShort() & 0xffff
            val utf8 = new Array[String](constantPoolCount)
            val classNames = mutable.ArrayBuffer.empty[Int]
            var index = 1
            var broken = false
            while index < constantPoolCount && !broken do {
                (buffer.get() & 0xff) match {
                    case 1 =>
                        val length = buffer.getShort() & 0xffff
                        val bytes = new Array[Byte](length)
                        buffer.get(bytes)
                        utf8(index) = new String(bytes, StandardCharsets.UTF_8)
                    case 7 =>
                        classNames += (buffer.getShort() & 0xffff)
                    case 8 | 16 | 19 | 20 =>
                        buffer.getShort()
                    case 3 | 4 | 9 | 10 | 11 | 12 | 17 | 18 =>
                        buffer.getInt()
                    case 5 | 6 =>
                        buffer.getLong()
                        index += 1 // long/double 占两个常量池槽位
                    case 15 =>
                        buffer.get()
                        buffer.getShort()
                    case _ =>
                        broken = true
                }
                index += 1
            }
            if broken then Seq.empty
            else
                classNames.toSeq.flatMap { nameIndex =>
                    if nameIndex <= 0 || nameIndex >= constantPoolCount || utf8(nameIndex) == null then Nil
                    else normalizeClassName(utf8(nameIndex)).toSeq
                }
        }
    }

    /** `[Lpkg/Foo;` -> `pkg/Foo`；基本类型数组与普通类名原样返回。 */
    private def normalizeClassName(raw: String): Option[String] = {
        val name = raw.dropWhile(_ == '[')
        if name.startsWith("L") && name.endsWith(";") then Some(name.substring(1, name.length - 1))
        else if name == raw || name.isEmpty then Some(name)
        else None
    }

    /** 入口点的字节码依赖摘要：从主类 class 文件出发，沿项目 class 目录里的类引用做 BFS， 对可达的每个 .class 内容求 SHA-256。项目外的类由依赖 classpath 的标识兜底。
      */
    private def entryDigest(
        mainClass: String,
        classIndex: Map[String, os.Path],
        references: String => Seq[String]
    ): String = {
        val visited = mutable.Set.empty[String]
        val reached = mutable.ArrayBuffer.empty[String]
        val queue = mutable.Queue(mainClass.replace('.', '/'))
        while queue.nonEmpty do {
            val className = queue.dequeue()
            if visited.add(className) then
                classIndex.get(className) match {
                    case Some(path) =>
                        reached += className + "\n" + sha256(Files.readAllBytes(path.toNIO))
                        references(className).foreach { referenced =>
                            if classIndex.contains(referenced) && !visited.contains(referenced) then
                                queue.enqueue(referenced)
                        }
                    case None => () // 项目外的类：交给依赖 classpath 的标识
                }
        }
        if reached.isEmpty then sha256(mainClass)
        else sha256(reached.sorted.mkString("\n"))
    }

    private def sha256(bytes: Array[Byte]): String = {
        val digest = MessageDigest.getInstance("SHA-256").digest(bytes)
        digest.map(byte => f"${byte & 0xff}%02x").mkString
    }

    private def sha256(text: String): String = sha256(text.getBytes(StandardCharsets.UTF_8))
}
